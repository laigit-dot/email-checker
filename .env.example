# Application (client) ID from an Entra public-client app registration.
# Required delegated Microsoft Graph permission: Mail.ReadWrite
CLIENT_ID=PASTE-YOUR-APPLICATION-CLIENT-ID-HERE

# Organizer debug logs (console + organizer-debug.log). Default is off.
# Set to 1, true, on, yes, or enabled to turn them on.
# ORGANIZER_LOG=1

# Required for `watch` (push on new mail). Public HTTPS URL that forwards
# to this machine's webhook listener.
# Example: start a tunnel, then paste the https URL + path:
#   cloudflared tunnel --url http://127.0.0.1:8787
#   WEBHOOK_URL=https://random-subdomain.trycloudflare.com/notify
WEBHOOK_URL=
WEBHOOK_PORT=8787
WEBHOOK_PATH=/notify
# Optional shared secret echoed in Graph notifications (auto-generated if empty)
WEBHOOK_CLIENT_STATE=
